{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Export lab notebook to PDF (no TeX)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/tools/export_notebook.py",
        "${workspaceFolder}/Lab/Lab1_Deutsch_Jozsa.ipynb"
