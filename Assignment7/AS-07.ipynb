     "text": [
      "Z|-> = [0.70710678+0.j 0.70710678+0.j]\n",
      "|+>  = [0.70710678 0.70710678]\n",
      "Equal: True\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "Z = np.array([[1, 0],\n",
    "              [0, -1]], dtype=complex)\n",
    "\n",
    "minus = np.array([1, -1]) / np.sqrt(2)\n",
    "plus  = np.array([1,  1]) / np.sqrt(2)\n",
    "\n",
    "result = Z @ minus\n",
    "\n",
    "print(\"Z|-> =\", result)\n",
    "print(\"|+>  =\", plus)\n",
    "print(\"Equal:\", np.allclose(result, plus))"
   ]
  },
